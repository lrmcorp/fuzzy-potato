# systemd unit for ARAH. Copy to /etc/systemd/system/arah.service, replace USER and
# the two paths, then: sudo systemctl daemon-reload && sudo systemctl enable --now arah
[Unit]
Description=ARAH market direction briefings
After=network-online.target
Wants=network-online.target

[Service]
User=USER
WorkingDirectory=/home/USER/fuzzy-potato
ExecStart=/home/USER/fuzzy-potato/.venv/bin/arah up
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
